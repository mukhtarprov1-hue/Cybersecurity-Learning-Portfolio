# Required for POST, PUT and DELETE. Use a unique local training value.
API_TOKEN=replace-with-a-long-random-local-token

# Browser origin allowed by the development CORS policy.
API_ALLOWED_ORIGIN=http://localhost:3000

# Required for the tamper-evident audit chain. Use at least 32 random bytes,
# preferably generated by scripts/load-audit-key.ps1. Never commit the real key.
AUDIT_HMAC_KEY=replace-with-a-random-secret-of-at-least-32-bytes

# The API currently uses a fixed 64 KiB body limit.
